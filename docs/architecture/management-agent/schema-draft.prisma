/// @@merge-into User
model User_Fragment {
  /// 既定の会社（ホームで最初に開く会社）。複数所属時は Session.companyId が優先
  defaultCompanyId    String?
  /// Google の hd クレーム（Workspace ドメイン）。個人 Gmail は null
  googleHostedDomain  String?
  /// 最終 Google 認証時刻（id_token の auth_time。Google の ID トークン claims 表に存在。要実機確認: 値がセッション再利用時に更新されない可能性）
  lastAuthAt          DateTime?
  /// 全セッション一括失効の基準。これより古い Session.createdAt は無効扱い（adapter.getSessionAndUser で null を返す）
  sessionsInvalidBefore DateTime?

  companyMemberships  CompanyMember[]
  companyInvitationsSent CompanyInvitation[] @relation("CompanyInvitationInvitedBy")
  sessionDevices      SessionDevice[]
  webauthnCredentials WebAuthnCredential[]
  reauthChallenges    ReauthChallenge[]
  agentConversations  AgentConversation[]
  agentRunsRequested  AgentRun[]            @relation("AgentRunRequestedBy")
  approvalRequests    ApprovalRequest[]     @relation("ApprovalRequestedTo")
  coreNotifications   Notification[]
  usageLedgerEntries  UsageLedger[]
}

/// @@merge-into Account
model Account_Fragment {
  /// Google の email_verified（id_token から）。signIn で true を必須にする
  emailVerifiedClaim Boolean?
  /// Google の hd
  hostedDomain       String?
  // 既存 refresh_token / access_token / id_token 列は adapter ラップの linkAccount で **null にして保存**する
  // （Google API を呼ぶ用途が無い。access_type=offline は要求しない。SEC-08）
}

/// @@merge-into Session
model Session_Fragment {
  /// SessionDevice.id（同一端末の再ログインは置換、別端末は上限判定）
  deviceId      String?
  device        SessionDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  /// 「現在の会社」。切替は /api/company/switch（Cookie より改ざんに強い）
  companyId     String?
  /// 直近 IP の SHA-256（日替わり salt）。平文は保存しない
  ipHash        String?
  /// /24 or /48 帯（共有検知用）
  ipPrefix      String?
  /// 'JP' 等（x-vercel-ip-country）
  geoCountry    String?
  geoRegion     String?
  userAgentHash String?
  /// 1 分粒度で更新（updateAge=60 と同期）
  lastSeenAt    DateTime?
  createdAt     DateTime  @default(now())
  /// 失効（削除せず残し、監査に使う）。adapter.getSessionAndUser は revokedAt IS NOT NULL なら null を返す
  revokedAt     DateTime?
  /// 'limit' | 'logout' | 'member-removed' | 'admin' | 'suspicious' | 'invalid-before'
  revokedReason String?
  /// 最終 step-up 再認証時刻（パスキー or Google 再認可）
  stepUpAt      DateTime?
  /// 'passkey' | 'google'
  stepUpMethod  String?
  // sessionToken 列には Cookie 値そのものではなく sha256 を保存する（adapter ラップで写像。SEC-09）。列定義は NextAuth 標準のまま

  @@index([userId, revokedAt, lastSeenAt])
  @@index([deviceId])
}

