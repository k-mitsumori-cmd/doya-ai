// ドヤ収入管理 スキーマ下書き（2026-10-18）
// prisma/schema.prisma にはまだ入れていない。設計書 README.md §4 と対応。
// 金額はすべて Int（円）。他ツールへの参照（sfa* / quote*）は FK を張らない文字列。

model IncomeOrganization {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  /// 共通 Company 移行用（management-agent §16）。移行までは null
  companyId         String?
  /// SFA 連携先の組織（取引先・商談の取り込み元）
  sfaOrganizationId String?
  /// 支出の取り込み元（ドヤプロマネのワークスペース）。支出管理ができるまでの暫定（README §8.1）
  promaneWorkspaceId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  members   IncomeMember[]
  issuer    IncomeIssuer?
  clients   IncomeClient[]
  contracts IncomeContract[]
  invoices  IncomeInvoice[]
  payments  IncomePayment[]
  reminders IncomeReminder[]
  auditLogs IncomeAuditLog[]

  @@index([companyId])
  @@map("income_organizations")
}

model IncomeMember {
  id             String             @id @default(cuid())
  organizationId String
  organization   IncomeOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  /// owner / admin / manager / member
  role           String             @default("member")
  /// ACTIVE / PENDING / INACTIVE
  status         String             @default("ACTIVE")
  inviteEmail    String?
  inviteToken    String?            @unique
  createdAt      DateTime           @default(now())

  calendar IncomeCalendarConnection?

  @@unique([organizationId, userId])
  @@map("income_members")
}

/// 請求元（自社）情報。QuoteIssuer から初期値を取り込める
model IncomeIssuer {
  organizationId       String             @id
  organization         IncomeOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyName          String
  postalCode           String?
  address              String?            @db.Text
  tel                  String?
  personName           String?
  /// 適格請求書発行事業者の登録番号（T + 13 桁）
  invoiceRegNo         String?
  logoPath             String?
  sealPath             String?
  bankName             String?
  bankBranch           String?
  /// ordinary（普通）/ checking（当座）
  bankAccountType      String?
  bankAccountNo        String?
  bankAccountHolder    String?
  /// 締め日。31 = 月末
  defaultClosingDay    Int                @default(31)
  /// 支払月。1 = 翌月
  defaultPaymentMonths Int                @default(1)
  /// 支払日。31 = 月末
  defaultPaymentDay    Int                @default(31)
  invoiceNotes         String?            @db.Text
  updatedAt            DateTime           @updatedAt

  @@map("income_issuers")
}

model IncomeClient {
  id                 String             @id @default(cuid())
  organizationId     String
  organization       IncomeOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name               String
  corporateNumber    String?
  postalCode         String?
  address            String?            @db.Text
  billingContactName String?
  billingDepartment  String?
  billingEmail       String?
  /// 振込名義（半角カナ正規化して保存）。入金照合に使う
  payerNameKana      String?
  /// 取引先ごとの支払条件。null なら IncomeIssuer の既定
  closingDay         Int?
  paymentMonths      Int?
  paymentDay         Int?
  /// SFA の取引先（FK なし。書き込み時に所有確認）
  sfaAccountId       String?
  note               String?            @db.Text
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  contracts IncomeContract[]
  invoices  IncomeInvoice[]
  schedules IncomeRevenueSchedule[]

  @@index([organizationId, isActive])
  @@index([organizationId, sfaAccountId])
  @@map("income_clients")
}

model IncomeContract {
  id                String             @id @default(cuid())
  organizationId    String
  organization      IncomeOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId          String
  client            IncomeClient       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  title             String
  contractNo        String?
  /// recurring（定額継続）/ one_time（単発）/ milestone（分割）
  type              String             @default("recurring")
  /// draft / active / paused / ended / cancelled
  status            String             @default("draft")
  startDate         DateTime           @db.Date
  endDate           DateTime?          @db.Date
  autoRenew         Boolean            @default(false)
  /// 自動更新の解約予告期限（終了日の何日前か）
  renewalNoticeDays Int?
  /// monthly / quarterly / yearly
  billingCycle      String             @default("monthly")
  /// advance（前払い）/ arrears（後払い）
  issueTiming       String             @default("arrears")
  /// none（初月から満額）/ daily（日割り）
  prorate           String             @default("none")
  /// 1 回の請求額（税抜）。明細の合計と一致させる
  amountExclTax     Int
  documentPath      String?
  signedAt          DateTime?
  /// AI 読み取り結果の原文（確認画面で並べて表示する）
  aiExtracted       Json?
  sfaDealId         String?
  quoteDocumentId   String?
  memo              String?            @db.Text
  createdByUserId   String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  items     IncomeContractItem[]
  schedules IncomeRevenueSchedule[]

  @@index([organizationId, status])
  @@index([organizationId, endDate])
  @@index([organizationId, sfaDealId])
  @@map("income_contracts")
}

model IncomeContractItem {
  id         String         @id @default(cuid())
  contractId String
  contract   IncomeContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  name       String
  quantity   Int            @default(1)
  unitPrice  Int
  /// 10 / 8 / 0
  taxRate    Int            @default(10)
  sortOrder  Int            @default(0)

  @@map("income_contract_items")
}

/// 月次の売上予定。請求漏れ検知の要
model IncomeRevenueSchedule {
  id               String         @id @default(cuid())
  organizationId   String
  contractId       String
  contract         IncomeContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  clientId         String
  client           IncomeClient   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  /// 計上月（月初日）
  period           DateTime       @db.Date
  plannedIssueDate DateTime       @db.Date
  amountExclTax    Int
  /// planned / invoiced / skipped
  status           String         @default("planned")
  skipReason       String?
  invoiceItem      IncomeInvoiceItem?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([contractId, period])
  @@index([organizationId, period])
  @@index([organizationId, status, plannedIssueDate])
  @@map("income_revenue_schedules")
}

model IncomeInvoice {
  id              String             @id @default(cuid())
  organizationId  String
  organization    IncomeOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId        String
  client          IncomeClient       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  /// 確定時に採番。下書きは null
  invoiceNo       String?
  title           String?
  issueDate       DateTime           @db.Date
  dueDate         DateTime           @db.Date
  /// draft / confirmed / sent / void（入金状態は paidAmount から計算）
  status          String             @default("draft")
  subtotalExclTax Int                @default(0)
  taxAmount       Int                @default(0)
  totalInclTax    Int                @default(0)
  /// 消込の合計。遅延は dueDate と残高から読むときに計算する
  paidAmount      Int                @default(0)
  /// [{ rate: 10, base: 300000, tax: 30000 }, ...] 税率ごとに 1 回丸め
  taxBreakdown    Json?
  /// 確定時点の請求元情報（登録番号・振込先など）
  issuerSnapshot  Json?
  /// 確定時点の請求先情報
  clientSnapshot  Json?
  notes           String?            @db.Text
  pdfPath         String?
  confirmedBy     String?
  confirmedAt     DateTime?
  sentAt          DateTime?
  sentTo          String?
  voidedAt        DateTime?
  voidReason      String?
  /// 再発行元
  replacesId      String?
  quoteDocumentId String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  items       IncomeInvoiceItem[]
  allocations IncomePaymentAllocation[]

  @@unique([organizationId, invoiceNo])
  @@index([organizationId, status, dueDate])
  @@index([organizationId, clientId])
  @@map("income_invoices")
}

model IncomeInvoiceItem {
  id            String                 @id @default(cuid())
  invoiceId     String
  invoice       IncomeInvoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  scheduleId    String?                @unique
  schedule      IncomeRevenueSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  name          String
  quantity      Int                    @default(1)
  unitPrice     Int
  taxRate       Int                    @default(10)
  amountExclTax Int
  sortOrder     Int                    @default(0)

  @@map("income_invoice_items")
}

model IncomeInvoiceSequence {
  organizationId String
  year           Int
  lastNo         Int    @default(0)

  @@id([organizationId, year])
  @@map("income_invoice_sequences")
}

model IncomePayment {
  id             String             @id @default(cuid())
  organizationId String
  organization   IncomeOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  receivedOn     DateTime           @db.Date
  amount         Int
  /// 振込手数料の差引（先方負担のはずが差し引かれた等）
  feeDeducted    Int                @default(0)
  payerName      String?
  /// manual / csv
  source         String             @default("manual")
  /// CSV 明細の重複取込防止キー（日付・金額・名義・残高のハッシュ等）
  externalKey    String?
  /// unmatched / partial / matched
  status         String             @default("unmatched")
  memo           String?
  createdByUserId String
  createdAt      DateTime           @default(now())

  allocations IncomePaymentAllocation[]

  @@unique([organizationId, externalKey])
  @@index([organizationId, status])
  @@index([organizationId, receivedOn])
  @@map("income_payments")
}

model IncomePaymentAllocation {
  id        String        @id @default(cuid())
  paymentId String
  payment   IncomePayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   IncomeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount    Int
  /// rule / ai / manual
  matchedBy String        @default("manual")
  createdAt DateTime      @default(now())

  @@unique([paymentId, invoiceId])
  @@map("income_payment_allocations")
}

model IncomeReminder {
  id              String             @id @default(cuid())
  organizationId  String
  organization    IncomeOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// issue_due / payment_due / overdue / renewal / contract_end / draft_contract
  kind            String
  dueOn           DateTime           @db.Date
  /// schedule / invoice / contract
  targetType      String
  targetId        String
  /// open / done / dismissed
  status          String             @default("open")
  notifiedAt      DateTime?
  calendarEventId String?
  createdAt       DateTime           @default(now())

  @@unique([organizationId, kind, targetType, targetId])
  @@index([organizationId, status, dueOn])
  @@map("income_reminders")
}

model IncomeCalendarConnection {
  id              String       @id @default(cuid())
  memberId        String       @unique
  member          IncomeMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  /// google / ics
  provider        String
  calendarId      String?
  /// アプリ側で暗号化して保存（平文で持たない）
  refreshTokenEnc String?      @db.Text
  /// ICS 購読 URL 用。32 バイト以上の乱数、再発行で無効化
  icsToken        String?      @unique
  hideAmounts     Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@map("income_calendar_connections")
}

model IncomeAuditLog {
  id             String             @id @default(cuid())
  organizationId String
  organization   IncomeOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUserId    String
  action         String
  targetType     String
  targetId       String
  diff           Json?
  createdAt      DateTime           @default(now())

  @@index([organizationId, targetType, targetId])
  @@map("income_audit_logs")
}
