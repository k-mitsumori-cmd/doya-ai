// ============================================================
// ドヤAI質問リンク（asklink）— 仕様: reference/services/asklink.md
// ------------------------------------------------------------
// サイトURL1つから「AIに聞く」リンク2本とポップアップ用バナー3枚を作る。
// ⚠️ userId でスコープする（ログイン必須）。他人の結果は findFirst({ id, userId }) で弾く。
// ⚠️ 利用枠の単位は run。作成時に1件として数える（失敗・削除しても戻さない。読み取り不能は行を作らない）。
// ============================================================
model AskLinkRun {
  id               String   @id @default(cuid())
  userId           String
  sourceUrl        String
  /// 'b2b' | 'b2c'（利用者が切り替え可能）
  audience         String   @default("b2b")
  /// AIが判定した ToB/ToC（切り替え前の値）
  detectedAudience String   @default("b2b")
  /// 抽出結果（会社名・サービス内容・強み・対象顧客・各種URL・色）。'manual' のときは手入力
  site             Json
  /// サイト上で実際に見つかったURLの集合。質問文中のURLはこの中にしか置けない
  allowedUrls      Json
  /// 'site' | 'manual'
  source           String   @default("site")
  /// 質問リンク2本 [{ key, buttonLabel, question, url, check }]
  links            Json?
  /// バナーの文言（見出し・小見出し・吹き出し3つ）
  bannerCopy       Json?
  /// ToB/ToC 切り替え等によるリンク再生成の回数（乱用防止）
  linkGenerations  Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  banners AskLinkBanner[]

  @@index([userId, createdAt])
  @@map("asklink_run")
}

model AskLinkBanner {
  id          String     @id @default(cuid())
  runId       String
  run         AskLinkRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  /// 'landscape' | 'square' | 'portrait'
  kind        String
  /// Storage のパス（署名URLは都度発行）
  imagePath   String?
  /// 'pending' | 'done' | 'failed'
  status      String     @default("pending")
  /// OCR照合の結果 { ok, needsReview, missing[], detectedText? }
  verify      Json?
  model       String?
  /// 生成を実行した回数（作り直しの上限判定）
  generations Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([runId, kind])
  @@map("asklink_banner")
}

// ============================================================
// ドヤポップアップ（popup）— 仕様: reference/services/popup.md
// ------------------------------------------------------------
// URL1つからポップアップを提案し、埋め込みタグで配信して、表示・クリックを日別に数える。
// ⚠️ userId でスコープする（ログイン必須）。他人のサイト・案は findFirst({ id, userId }) で弾く。
// ⚠️ creative / trigger / targeting / frequency の形は src/lib/popup/schema.ts の sanitize*() が正本。
// ⚠️ 計測は生ログを持たず、popup_stat に日別で加算する（行数を表示回数に比例させない）。
// ============================================================
model PopupSite {
  id          String    @id @default(cuid())
  userId      String
  name        String
  sourceUrl   String
  /// 表示を許すホスト（www なし・小文字）。サブドメインも許す
  domain      String
  /// 埋め込みタグに載せる公開キー（推測できない乱数）
  siteKey     String    @unique
  /// 抽出結果（asklink の SiteProfile と同じ形）
  site        Json
  /// サイト上で実際に見つかったURLの集合。ポップアップのリンク先はこの中から選ぶ
  allowedUrls Json
  /// 'b2b' | 'b2c'
  audience    String    @default("b2b")
  /// 'site' | 'manual'
  source      String    @default("site")
  /// 予約列（統合仕様 R-5）: 経営ホームの会社情報（CompanyProfile）を指す。null 可・FK なし。
  /// 自社プロフィールの写しを新設しないため、会社情報が入ったらここで参照する
  companyProfileId String?
  /// 埋め込みタグからの最終アクセス（設置確認。10分に1回まで更新）
  lastSeenAt  DateTime?
  /// 削除日時。⚠️ 行は消さない（消すと提案回数の数え直しで無料枠が戻ってしまう）
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  popups Popup[]

  @@index([userId, createdAt])
  @@map("popup_site")
}

model Popup {
  id        String    @id @default(cuid())
  siteId    String
  site      PopupSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  userId    String
  name      String
  /// 'ask' | 'cta' | 'pages' | 'image'
  kind      String
  /// 'draft' | 'live' | 'paused'
  status    String    @default("draft")
  sortOrder Int       @default(0)
  creative  Json
  trigger   Json
  targeting Json
  frequency Json
  /// 提案の理由（画面表示用）
  reason    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  stats PopupStat[]

  @@index([siteId, status, sortOrder])
  @@index([userId])
  @@map("popup")
}

model PopupStat {
  popupId     String
  popup       Popup    @relation(fields: [popupId], references: [id], onDelete: Cascade)
  /// JST の日付
  day         DateTime @db.Date
  /// 'main'（表示・閉じる・ボタン）か 'link:N'（リスト内のN番目のリンク）
  target      String   @default("main")
  impressions Int      @default(0)
  clicks      Int      @default(0)
  closes      Int      @default(0)

  @@id([popupId, day, target])
  @@map("popup_stat")
}

// ============================================================
// ドヤ展示会（tenjikai）— 試作: ~/Code/sandbox/doya-tenjikai
// ------------------------------------------------------------
// URLと出展条件から、ブース設営案・制作物・ノベルティ・予算・業者選定・締切を一括で用意する。
