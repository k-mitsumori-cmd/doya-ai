{
  "name": "doya-ai",
  "version": "1.0.0",
  "description": "ドヤAI - ドヤSEO / ドヤバナーなどの統合ポータル",
  "private": true,
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && npm run test:security && npm run test:asklink && npm run test:popup && npm run test:syscheck && npm run test:tenjikai && npm run test:shanai && npm run test:income && npm run test:expense && npm run test:doyapower && npm run test:shell && npm run test:agent && npm run test:slack && npm run test:pricing && npm run test:health-check && tsc --noEmit && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "test:security": "node scripts/security-regression/run.cjs",
    "test:asklink": "tsx --test src/lib/asklink/link.test.ts src/lib/asklink/scope.test.ts",
    "test:popup": "tsx --test src/lib/popup/schema.test.ts src/lib/popup/scope.test.ts src/lib/popup/read.test.ts",
    "test:syscheck": "tsx --test src/lib/syscheck-guards.test.ts src/lib/server-daily-quota.test.ts src/lib/drip-click-link.test.ts src/lib/mitsuboshi/nagusame/guest.test.ts src/lib/interview/file-signature.test.ts src/lib/doyaslide/file-urls.test.ts src/lib/ui-next.test.ts src/lib/shell/company.test.ts 'src/app/(shell)/home/today.test.ts' src/components/shell/heading-guard.test.ts src/lib/shell/recent.test.ts src/components/ds/chart-math.test.ts src/components/ds/next-step.test.tsx",
    "test:tenjikai": "tsx --test src/lib/tenjikai/engine.test.ts src/lib/tenjikai/tenjikai-read.test.ts src/lib/tenjikai/image-route.test.ts src/lib/tenjikai/local-store.test.ts",
    "test:shanai": "tsx --test src/lib/shanai/shanai.test.ts",
    "test:income": "tsx --test src/lib/income/calc.test.ts src/lib/income/scope.test.ts src/lib/income/agent.test.ts",
    "test:expense": "tsx --test src/lib/expense/calc.test.ts src/lib/expense/scope.test.ts src/lib/expense/members.test.ts",
    "test:doyapower": "tsx --test src/lib/doya-power/ledger.test.ts src/lib/doya-power/charge.test.ts src/lib/doya-power/voice.test.ts src/lib/doya-power/count.test.ts src/lib/doya-power/history.test.ts src/lib/doya-power/retry.test.ts src/lib/doya-power/whatyoucando.test.ts src/lib/doya-power/watch.test.ts src/components/doya-power/insufficient.test.ts src/lib/collection/collection.test.ts src/lib/missions/missions.test.ts",
    "test:shell": "tsx --test src/components/shell/registry.test.ts",
    "test:agent": "tsx --test src/lib/agent-orchestration/runner.test.ts src/lib/agent-orchestration/tools.test.ts src/lib/agent-orchestration/plan.test.ts src/lib/agent-orchestration/runs.test.ts",
    "test:slack": "tsx --test src/lib/slack/notify.test.ts",
    "test:pricing": "tsx --test src/lib/pricing-v2/pricing-v2.test.ts src/lib/pricing-v2/team.test.ts src/lib/pricing-v2/upsell.test.ts src/lib/pricing-v2/flag-off.test.ts",
    "test:health-check": "tsx --test src/lib/health-check-report.test.ts scripts/ci-failure-report.test.cjs src/lib/system-watch/decide.test.ts src/lib/system-watch/http.test.ts src/lib/system-watch/checks.test.ts src/lib/system-watch/marker.test.ts src/lib/system-watch/watch-gate.test.ts src/lib/system-watch/marked-records.test.ts src/lib/system-watch/marked-records-range.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@google/generative-ai": "^0.24.1",
    "@mozilla/readability": "^0.6.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.7.1",
    "@resvg/resvg-js": "^2.6.2",
    "@sparticuz/chromium": "152.0.0",
    "@stripe/stripe-js": "^2.2.2",
    "@supabase/supabase-js": "^2.95.3",
    "@types/archiver": "^7.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/uuid": "^10.0.0",
    "@vercel/functions": "^3.9.6",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.0.0",
    "docx": "9.5.1",
    "exceljs": "^4.4.0",
    "framer-motion": "^10.17.0",
    "google-auth-library": "^9.15.1",
    "html2canvas": "^1.4.1",
    "jsdom": "^28.1.0",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.303.0",
    "mediainfo.js": "^0.3.8",
    "next": "15.5.25",
    "next-auth": "4.24.15",
    "openai": "^4.24.1",
    "otpauth": "^9.5.1",
    "pptxgenjs": "^3.12.0",
    "puppeteer-core": "25.10.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "recharts": "^3.8.1",
    "resend": "^6.12.4",
    "satori": "^0.18.3",
    "sharp": "0.35.4",
    "sonner": "^2.0.7",
    "stripe": "^14.10.0",
    "tailwind-merge": "^2.2.0",
    "tldts": "7.0.23",
    "undici": "^7.29.0",
    "uuid": "^13.0.0",
    "zod": "^3.22.4",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^20.10.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.25",
    "fast-xml-parser": "^5.11.2",
    "jszip": "^3.10.1",
    "postcss": "^8.5.28",
    "prisma": "^5.7.1",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "postcss": "$postcss",
    "pptxgenjs": {
      "image-size": "2.0.4"
    },
    "exceljs": {
      "uuid": "11.1.1"
    },
    "gaxios": {
      "uuid": "11.1.1"
    }
  }
}
